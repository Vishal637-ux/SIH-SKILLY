# Application Configuration
APP_NAME=SKILLY
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL with asyncpg for async ORM & psycopg2 for Alembic sync migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skilly

# Async Database URL (used by FastAPI / SQLAlchemy async engine)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skilly

# Sync Database URL (used by Alembic migrations)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skilly

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
